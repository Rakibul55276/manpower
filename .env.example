APP_NAME=Manpower
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://erp.example.sa


LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=manpower
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
PRIVATE_DOCUMENT_DISK=local
STOCK_MOVEMENT_DOCUMENT_DIR=safety-shop/stock-documents

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
INVOICING_ENABLED=false
DOCUMENT_LIBRARY_ENABLED=true
ZATCA_ENABLED=false
ZATCA_ENVIRONMENT=disabled
ZATCA_SIMULATION_OTP=
ZATCA_CONNECT_TIMEOUT=10
ZATCA_REQUEST_TIMEOUT=30
ZATCA_SDK_HOME=
ZATCA_SDK_VERSION=3.0.8
ZATCA_JAVA_BINARY=
ZATCA_SDK_CERTIFICATE_PASSWORD=123456789
ZATCA_OPENSSL_BINARY=
# Override only when ZATCA publishes or assigns different endpoints.
ZATCA_SIMULATION_URL=https://gw-fatoora.zatca.gov.sa/e-invoicing/simulation
ZATCA_PRODUCTION_URL=https://gw-fatoora.zatca.gov.sa/e-invoicing/core
SAFETY_SHOP_ENABLED=true
MANPOWER_ENABLED=true
SAAS_VOUCHER_ENABLED=true
SAAS_VOUCHER_GRACE_DAYS=7
QUOTATION_MODULE_ENABLED=true
DELIVERY_NOTE_MODULE_ENABLED=true
